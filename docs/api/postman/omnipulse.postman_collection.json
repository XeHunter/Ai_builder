{
  "info": {
    "name": "OmniPulse AI - demo journeys",
    "_postman_id": "omnipulse-demo-journeys",
    "description": "Smoke tests for the demo journeys against a seeded API. Run: postman collection run docs/api/postman/omnipulse.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Shopper",
      "item": [
        {
          "name": "Health ready",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"database ok\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login shopper",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya@demo.omnipulse.ai\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"customer account\", () => pm.expect(b.user.account_type).to.eql(\"customer\"));",
                  "pm.collectionVariables.set(\"shopperToken\", b.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "List stores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stores"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shopperToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stores = pm.response.json();",
                  "const and01 = stores.find(s => s.code === \"AND01\");",
                  "pm.test(\"AND01 exists\", () => pm.expect(and01).to.be.an(\"object\"));",
                  "pm.collectionVariables.set(\"storeId\", and01.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search products (synonym)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?q=nappies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stores",
                "{{storeId}}",
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "nappies"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shopperToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"diapers found via synonym\", () => pm.expect(b.items[0].name).to.match(/Diapers/));",
                  "pm.test(\"product has location\", () => pm.expect(b.items[0].location).to.be.an(\"object\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Parse smart list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shopping-lists/parse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shopping-lists",
                "parse"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shopperToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_id\": \"{{storeId}}\",\n  \"text\": \"Milk, eggs, bread, chocolate, diapers, detergent, and coffee.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"7 items parsed\", () => pm.expect(b.items.length).to.eql(7));",
                  "pm.test(\"all matched\", () => pm.expect(b.items.every(i => i.product_id)).to.be.true);",
                  "pm.collectionVariables.set(\"parsedItems\", JSON.stringify(b.items.map(i => ({raw_text: i.raw_text, product_id: i.product_id, quantity: i.quantity}))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shopping-lists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shopping-lists"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shopperToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"listId\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({name: \"Postman list\", store_id: pm.collectionVariables.get(\"storeId\"), items: JSON.parse(pm.collectionVariables.get(\"parsedItems\"))}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Plan route",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shopping-lists/{{listId}}/route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shopping-lists",
                "{{listId}}",
                "route"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shopperToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"7 items routed\", () => pm.expect(r.stops.flatMap(s => s.items).length).to.eql(7));",
                  "pm.test(\"optimised <= list order\", () => pm.expect(r.total_distance_m).to.be.at.most(r.unoptimized_distance_m));",
                  "pm.test(\"steps end at checkout\", () => pm.expect(r.steps[r.steps.length-1].type).to.eql(\"finish\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Assistant budget basket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assistant/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "assistant",
                "chat"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shopperToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_id\": \"{{storeId}}\",\n  \"message\": \"I need breakfast items for two people under \\u20b9500.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"within budget\", () => pm.expect(b.basket.total).to.be.at.most(500));",
                  "pm.test(\"grounded\", () => pm.expect(b.grounding.validated).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Merchant",
      "item": [
        {
          "name": "Login merchant admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@freshmart.demo\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"merchant admin\", () => pm.expect(pm.response.json().merchant.role).to.eql(\"merchant_admin\"));",
                  "pm.collectionVariables.set(\"merchantToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/overview?days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "overview"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const k = pm.response.json().kpis;",
                  "pm.test(\"has stock and products\", () => { pm.expect(k.total_products).to.be.above(0); pm.expect(k.total_stock_units).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Expiring batches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/expiry/batches?days=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "expiry",
                "batches"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "3"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "const milk = rows.find(r => r.batch_code === \"MLK-002-B1\");",
                  "pm.test(\"40-carton milk batch flagged\", () => pm.expect(milk).to.be.an(\"object\"));",
                  "if (milk && milk.price_change) pm.collectionVariables.set(\"priceChangeId\", milk.price_change.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Markdown recommendation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/pricing/changes/{{priceChangeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "pricing",
                "changes",
                "{{priceChangeId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pc = pm.response.json();",
                  "pm.test(\"respects floor\", () => pm.expect(pc.proposed_price).to.be.at.least(pc.floor_price));",
                  "pm.test(\"heuristic evidence\", () => pm.expect(pc.evidence.method).to.eql(\"heuristic_markdown_rule\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fraud queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/fraud/alerts?status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "fraud",
                "alerts"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"alerts to review\", () => pm.expect(pm.response.json().total).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tenant isolation (other merchant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@urbanbasket.demo\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"otherToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Other tenant cannot read FreshMart price change",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/pricing/changes/{{priceChangeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "pricing",
                "changes",
                "{{priceChangeId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 for foreign tenant\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "demoPassword",
      "value": "Demo@12345"
    }
  ]
}