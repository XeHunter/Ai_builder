rules_version = '2';

// Firestore is a read-only real-time mirror for browsers. The OmniPulse API (Admin SDK on Cloud Run)
// is the only writer of business data and bypasses these rules. Browsers sign in with a custom
// token minted by the API: uid = OmniPulse user id, token.merchant_id = tenant for store staff.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /shoppingLists/{listId} {
      function isMember() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/shoppingLists/$(listId)).data.members;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;

      match /events/{seq} {
        allow read: if isMember();
        allow write: if false;
      }

      // Presence heartbeats: members may only write their own document, with a fixed shape.
      match /presence/{uid} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['user_id', 'name', 'at'])
          && request.resource.data.user_id == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Merchant live operations feed: staff of that merchant only.
    match /merchants/{merchantId}/feed/{entry} {
      allow read: if signedIn() && request.auth.token.merchant_id == merchantId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
