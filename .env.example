# ---------------------------------------------------------------------------
# OmniPulse AI - environment configuration (copy to .env and adjust).
# Every variable is optional for local demo mode. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
DEMO_MODE=true

# Database. Default (unset) is a local SQLite file backend/omnipulse.db.
# PostgreSQL (recommended; used by docker-compose):
# DATABASE_URL=postgresql+psycopg://omnipulse:omnipulse@localhost:5432/omnipulse
DATABASE_URL=

# Redis (optional): cross-instance WebSocket fan-out and shared rate limits.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Auth / sessions  (JWT_SECRET is REQUIRED and must be strong in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false            # true behind HTTPS (required in production)
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_PER_MINUTE=10
INVITATION_TTL_HOURS=72
FRONTEND_BASE_URL=http://localhost:5173

# AI provider: demo (deterministic, no key) | openai | gemini
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=256
AI_REQUEST_TIMEOUT_SECONDS=30

# Weather: simulated (default) | openweathermap
WEATHER_PROVIDER=simulated
OPENWEATHER_API_KEY=

# Notifications: email via log (simulated) or smtp
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@omnipulse.local

# Uploads
MAX_UPLOAD_MB=5
MAX_CSV_ROWS=5000

# Background jobs
RUN_WORKER_IN_PROCESS=true     # false when running `python -m app.tasks.worker` separately
WORKER_POLL_SECONDS=2
ENABLE_SCHEDULER=true
JOBS_EAGER=false

# Frontend (Vite) - API base for production builds served separately
VITE_API_BASE_URL=
